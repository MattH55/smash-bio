{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smash-bio.org/schema/smash-smfs-record.schema.json",
  "title": "SMASH-BIO single-molecule force spectroscopy record",
  "description": "One record per publication/experiment set. Generalises Table 3 of Halma, van Eck, Abeln et al., 'FAIR data for optical tweezers experiments' (Biophys. J. 124:1255-1272, 2025) from optical tweezers to every technique that applies force between two ends of a biological system (magnetic, torque, acoustic, centrifugal, nanopore, hydrodynamic, AFM, biomembrane force probe, micropipette, DNA-based tension sensors). Section names follow Table 3: hardware conditions, assay conditions, construct parameters, factors in solution; SMASH-BIO adds technique, biological_system, results, data_availability, annotations and provenance.",
  "type": "object",
  "required": [
    "record_id",
    "schema_version",
    "publication",
    "technique",
    "biological_system",
    "data_availability"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^SMFS-[0-9]{6}$"
    },
    "schema_version": {
      "const": "3.1.0"
    },
    "curation": {
      "$ref": "#/$defs/Curation"
    },
    "publication": {
      "$ref": "#/$defs/Publication"
    },
    "scope": {
      "type": "object",
      "properties": {
        "tier": {
          "enum": [
            "core",
            "methods",
            "peripheral"
          ],
          "description": "core = force applied between two ends of a biological system; methods = instrument/analysis development; peripheral = technique on biological sample without force spectroscopy"
        },
        "article_kind": {
          "enum": [
            "primary_research",
            "review",
            "methods",
            "preprint",
            "protocol",
            "correction",
            "other"
          ]
        }
      }
    },
    "technique": {
      "$ref": "#/$defs/Technique"
    },
    "hardware": {
      "$ref": "#/$defs/Hardware"
    },
    "assay": {
      "$ref": "#/$defs/Assay"
    },
    "biological_system": {
      "$ref": "#/$defs/BiologicalSystem"
    },
    "solution": {
      "$ref": "#/$defs/Solution"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "smash-smfs-results.schema.json#/$defs/Result"
      }
    },
    "data_availability": {
      "$ref": "#/$defs/DataAvailability"
    },
    "annotations": {
      "$ref": "#/$defs/Annotations"
    },
    "fair_completeness": {
      "$ref": "#/$defs/Completeness"
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    }
  },
  "$defs": {
    "Quantity": {
      "type": "object",
      "description": "A measured or reported value with unit: a single value, a min/max range, or (rarely) only a note such as \"room temperature\".",
      "required": [
        "unit"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "description": "UCUM-compatible unit, e.g. nm, mW, pN/nm, kHz, K, um, mbar, mm/s"
        },
        "uncertainty": {
          "type": [
            "number",
            "null"
          ]
        },
        "uncertainty_type": {
          "enum": [
            "SD",
            "SEM",
            "CI95",
            "fit_error",
            "range",
            "manufacturer_tolerance",
            "unspecified"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "note": {
          "type": "string",
          "description": "free-text qualifier, e.g. \"room temperature\" or why a range is given"
        }
      },
      "anyOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        },
        {
          "required": [
            "note"
          ]
        }
      ]
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "scheme": {
          "type": "string",
          "description": "Identifier namespace (identifiers.org prefix). Recommended: uniprot, pdb, genbank, refseq, rfam, chebi, cas, smiles, inchikey, pubchem, ncbitaxon, cl, cellosaurus, hca, go, hgnc, ensembl, emdb, addgene, doi, url, other, ena, emdb, empiar, biostudies, rrid, pmid",
          "examples": [
            "uniprot",
            "pdb",
            "genbank",
            "refseq",
            "rfam",
            "chebi",
            "cas",
            "smiles",
            "inchikey",
            "pubchem",
            "ncbitaxon",
            "cl",
            "cellosaurus",
            "hca",
            "go",
            "hgnc",
            "ensembl",
            "emdb",
            "addgene",
            "doi",
            "url",
            "other"
          ]
        },
        "id": {
          "type": "string"
        },
        "verified": {
          "type": "boolean",
          "description": "true when resolved against the source database at build time"
        }
      },
      "required": [
        "scheme",
        "id"
      ]
    },
    "Evidence": {
      "type": "object",
      "description": "Where a value came from, so every auto-populated field is auditable.",
      "properties": {
        "field": {
          "type": "string"
        },
        "method": {
          "enum": [
            "author_submitted",
            "manual_curation",
            "llm_review",
            "regex_title_abstract",
            "regex_fulltext_methods",
            "europepmc_textmining",
            "gazetteer",
            "datacite",
            "scholix",
            "europepmc_datalinks",
            "fulltext_statement",
            "repository_api",
            "inferred"
          ]
        },
        "section": {
          "type": "string"
        },
        "snippet": {
          "type": "string",
          "maxLength": 400
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "Curation": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "auto_abstract",
            "auto_fulltext",
            "ai_assisted",
            "curated",
            "author_verified"
          ],
          "description": "auto_abstract: title/abstract only; auto_fulltext: + OA methods & data statements; ai_assisted: fields reviewed by an LLM against the open full text (evidence snippets required, not human-checked); curated: checked by a human; author_verified: submitted/confirmed by authors"
        },
        "last_updated": {
          "type": "string",
          "format": "date"
        },
        "curators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "Publication": {
      "type": "object",
      "properties": {
        "doi": {
          "type": "string"
        },
        "pmid": {
          "type": "string"
        },
        "pmcid": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affiliations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "journal": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        },
        "publication_date": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mesh_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_access": {
          "type": "boolean"
        },
        "license": {
          "type": "string"
        },
        "cited_by": {
          "type": "integer"
        },
        "funders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Technique": {
      "type": "object",
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/TechniqueName"
        },
        "secondary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TechniqueName"
          }
        },
        "force_application_geometry": {
          "enum": [
            "dumbbell_dual_trap",
            "single_trap_surface_tether",
            "three_bead_assay",
            "four_trap_braid",
            "bead_on_surface_magnetic",
            "freely_orbiting_magnetic",
            "cantilever_tip_surface",
            "cantilever_cell_surface",
            "bead_on_surface_acoustic",
            "bead_on_surface_centrifugal",
            "nanopore_translocation",
            "flow_tethered_end",
            "doubly_tethered_curtain",
            "micropipette_bead",
            "biomembrane_force_probe",
            "cell_surface_tension_sensor",
            "dna_origami_clamp",
            "in_vivo_trapped_organelle",
            "membrane_tether_extrusion",
            "other"
          ]
        },
        "correlative_modalities": {
          "type": "array",
          "items": {
            "enum": [
              "confocal_fluorescence",
              "widefield_fluorescence",
              "TIRF",
              "smFRET",
              "STED",
              "IRM",
              "brightfield_video",
              "darkfield",
              "Raman",
              "electrophysiology",
              "high_speed_AFM_imaging",
              "label_free_scattering"
            ]
          }
        },
        "multiplexed": {
          "type": "boolean",
          "description": "many tethers measured in parallel (MT, AFS, CFM, DNA curtains)"
        },
        "force_range_pN": {
          "$ref": "#/$defs/Quantity"
        },
        "force_resolution_pN": {
          "$ref": "#/$defs/Quantity"
        },
        "spatial_resolution_nm": {
          "$ref": "#/$defs/Quantity"
        },
        "temporal_resolution_s": {
          "$ref": "#/$defs/Quantity"
        }
      }
    },
    "TechniqueName": {
      "enum": [
        "optical_tweezers",
        "magnetic_tweezers",
        "torque_tweezers",
        "afm_smfs",
        "acoustic_force_spectroscopy",
        "centrifuge_force",
        "nanopore_force",
        "hydrodynamic_stretching",
        "biomembrane_force_probe",
        "micropipette",
        "tension_sensors",
        "microneedle",
        "force_spectroscopy_unspecified"
      ]
    },
    "Hardware": {
      "type": "object",
      "description": "Table 3 'Hardware conditions' (common block) plus technique-specific sub-blocks.",
      "properties": {
        "make_of_setup": {
          "type": "string",
          "description": "Brand name or 'custom'"
        },
        "custom_built": {
          "type": "boolean"
        },
        "model_number": {
          "type": "string"
        },
        "detection_device": {
          "type": "array",
          "items": {
            "enum": [
              "QPD",
              "PSD",
              "camera_CMOS",
              "camera_CCD",
              "camera_sCMOS",
              "camera_EMCCD",
              "photodiode",
              "BFP_interferometry",
              "cantilever_deflection",
              "ionic_current",
              "other"
            ]
          }
        },
        "objective_lens": {
          "type": "object",
          "properties": {
            "make": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "numerical_aperture": {
              "type": "number"
            },
            "magnification": {
              "type": "number"
            },
            "immersion": {
              "enum": [
                "water",
                "oil",
                "glycerol",
                "air",
                "silicone"
              ]
            }
          }
        },
        "optical_filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "make": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "parameters": {
                "type": "string"
              }
            }
          }
        },
        "temperature": {
          "$ref": "#/$defs/Quantity"
        },
        "acquisition_rate": {
          "$ref": "#/$defs/Quantity"
        },
        "filter_frequency": {
          "$ref": "#/$defs/Quantity"
        },
        "line_scanning_rate": {
          "$ref": "#/$defs/Quantity"
        },
        "calibration_technique": {
          "type": "array",
          "items": {
            "enum": [
              "power_spectrum_passive",
              "power_spectrum_active",
              "equipartition",
              "stokes_drag",
              "step_response",
              "thermal_noise_cantilever",
              "sader",
              "allan_variance",
              "image_based_variance",
              "flow_calibration",
              "dna_force_extension_reference",
              "manufacturer",
              "other"
            ]
          }
        },
        "optical": {
          "type": "object",
          "description": "optical_tweezers / torque optical traps",
          "properties": {
            "laser_wavelength": {
              "$ref": "#/$defs/Quantity"
            },
            "laser_power_at_source": {
              "$ref": "#/$defs/Quantity"
            },
            "laser_power_at_objective": {
              "$ref": "#/$defs/Quantity"
            },
            "spatial_laser_control": {
              "type": "array",
              "items": {
                "enum": [
                  "AOD",
                  "EOD",
                  "piezo_mirror",
                  "galvo_mirror",
                  "SLM",
                  "piezo_stage",
                  "none"
                ]
              }
            },
            "number_of_traps": {
              "type": "integer"
            },
            "trap_stiffness": {
              "$ref": "#/$defs/Quantity"
            },
            "trap_stiffness_uncertainty": {
              "$ref": "#/$defs/Quantity"
            }
          }
        },
        "magnetic": {
          "type": "object",
          "properties": {
            "magnet_type": {
              "enum": [
                "permanent_pair",
                "permanent_single",
                "electromagnet",
                "cylindrical_ring",
                "other"
              ]
            },
            "magnet_gap": {
              "$ref": "#/$defs/Quantity"
            },
            "bead_product": {
              "type": "string",
              "examples": [
                "Dynabeads M-270 Streptavidin",
                "Dynabeads MyOne T1",
                "M-280"
              ]
            },
            "camera_frame_rate": {
              "$ref": "#/$defs/Quantity"
            },
            "parallel_tethers": {
              "type": "integer"
            },
            "rotation_control": {
              "type": "boolean"
            }
          }
        },
        "afm": {
          "type": "object",
          "properties": {
            "cantilever_model": {
              "type": "string",
              "examples": [
                "MLCT",
                "BioLever mini",
                "OBL-10",
                "AC40"
              ]
            },
            "spring_constant": {
              "$ref": "#/$defs/Quantity"
            },
            "resonance_frequency": {
              "$ref": "#/$defs/Quantity"
            },
            "tip_functionalization": {
              "type": "string"
            },
            "pulling_speed": {
              "$ref": "#/$defs/Quantity"
            },
            "feedback_mode": {
              "enum": [
                "constant_velocity",
                "force_clamp",
                "force_ramp",
                "dwell",
                "other"
              ]
            }
          }
        },
        "acoustic": {
          "type": "object",
          "properties": {
            "chip": {
              "type": "string"
            },
            "resonance_frequency": {
              "$ref": "#/$defs/Quantity"
            },
            "amplitude": {
              "$ref": "#/$defs/Quantity"
            }
          }
        },
        "centrifuge": {
          "type": "object",
          "properties": {
            "rotor_radius": {
              "$ref": "#/$defs/Quantity"
            },
            "angular_velocity": {
              "$ref": "#/$defs/Quantity"
            },
            "design": {
              "enum": [
                "wireless_benchtop",
                "commercial_centrifuge_module",
                "other"
              ]
            }
          }
        },
        "nanopore": {
          "type": "object",
          "properties": {
            "pore": {
              "type": "string",
              "examples": [
                "MspA M2",
                "alpha-hemolysin",
                "SiN solid-state"
              ]
            },
            "bias_voltage": {
              "$ref": "#/$defs/Quantity"
            },
            "motor_enzyme": {
              "type": "string"
            },
            "current_sampling_rate": {
              "$ref": "#/$defs/Quantity"
            }
          }
        },
        "hydrodynamic": {
          "type": "object",
          "properties": {
            "flow_rate": {
              "$ref": "#/$defs/Quantity"
            },
            "channel_dimensions": {
              "type": "string"
            },
            "viscosity": {
              "$ref": "#/$defs/Quantity"
            },
            "flow_to_force_calibration": {
              "type": "string"
            }
          }
        },
        "bfp_micropipette": {
          "type": "object",
          "properties": {
            "rbc_spring_constant": {
              "$ref": "#/$defs/Quantity"
            },
            "aspiration_pressure": {
              "$ref": "#/$defs/Quantity"
            },
            "probe_bead": {
              "type": "string"
            }
          }
        },
        "tension_sensor": {
          "type": "object",
          "properties": {
            "probe_type": {
              "enum": [
                "TGT",
                "DNA_hairpin",
                "PEG_spring",
                "FRET_protein",
                "origami"
              ]
            },
            "tension_threshold": {
              "$ref": "#/$defs/Quantity"
            }
          }
        }
      }
    },
    "Assay": {
      "type": "object",
      "description": "Table 3 'Assay conditions'.",
      "properties": {
        "experiment_class": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExperimentClass"
          }
        },
        "bead_geometry": {
          "enum": [
            "polymerization_assay",
            "one_bead",
            "two_bead_dumbbell",
            "three_bead",
            "four_bead",
            "bead_surface",
            "no_bead"
          ]
        },
        "bead_size": {
          "$ref": "#/$defs/Quantity"
        },
        "bead_size_uncertainty": {
          "$ref": "#/$defs/Quantity"
        },
        "bead_material": {
          "enum": [
            "polystyrene",
            "silica",
            "superparamagnetic",
            "gold",
            "other"
          ]
        },
        "bead_functionalization": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "examples": [
            [
              "streptavidin",
              "anti-digoxigenin"
            ]
          ]
        },
        "attachment_chemistry": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "both tether ends, e.g. biotin-streptavidin, digoxigenin-anti-dig, ybbR-CoA/Sfp, SpyTag/SpyCatcher, HaloTag, SNAP-tag, cysteine-maleimide, Ni-NTA/His-tag, cohesin-dockerin, click chemistry, covalent PEG"
        },
        "trap_control": {
          "type": "array",
          "items": {
            "enum": [
              "force_ramp",
              "force_clamp",
              "constant_force",
              "constant_distance",
              "passive_mode",
              "force_jump",
              "constant_velocity",
              "oscillatory",
              "rotation",
              "custom"
            ]
          }
        },
        "loading_rate": {
          "$ref": "#/$defs/Quantity"
        },
        "pulling_speed": {
          "$ref": "#/$defs/Quantity"
        },
        "force_profile": {
          "$ref": "#/$defs/DataPointer"
        },
        "extension_profile": {
          "$ref": "#/$defs/DataPointer"
        },
        "handle_sequences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "length_bp": {
                "type": "integer"
              },
              "fasta": {
                "type": "string"
              },
              "annotations": {
                "type": "string"
              },
              "accession": {
                "$ref": "#/$defs/Identifier"
              }
            }
          }
        },
        "flow_pressure": {
          "$ref": "#/$defs/Quantity"
        },
        "linear_flow_speed_at_bead": {
          "$ref": "#/$defs/Quantity"
        },
        "n_molecules": {
          "type": "integer"
        },
        "n_cycles": {
          "type": "integer"
        }
      }
    },
    "ExperimentClass": {
      "enum": [
        "unfolding_protein",
        "unfolding_nucleic_acid",
        "nucleic_acid_protein_interaction",
        "nucleic_acid_mechanics",
        "force_generation_motor",
        "force_generation_polymerization",
        "receptor_ligand_adhesion",
        "membrane_mechanics",
        "rheology_cell",
        "rheology_material",
        "chromatin_mechanics",
        "translation_transcription_replication",
        "methods_calibration"
      ],
      "description": "Table 3 columns (unfolding; DNA-protein interactions; force generation by cytoskeletal filaments or motors; rheology) refined into sub-classes."
    },
    "DataPointer": {
      "type": "object",
      "properties": {
        "dataset_doi": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "path_in_file": {
          "type": "string",
          "examples": [
            "Force HF/Force 1x"
          ]
        },
        "channel": {
          "type": "string"
        }
      }
    },
    "BiologicalSystem": {
      "type": "object",
      "description": "Table 3 'Construct parameters' for every experiment class.",
      "properties": {
        "summary": {
          "type": "string"
        },
        "system_class": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExperimentClass"
          }
        },
        "organisms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "ncbi_taxon": {
                "type": "integer"
              },
              "evidence": {
                "$ref": "#/$defs/Evidence"
              }
            }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MolecularEntity"
          }
        },
        "cell": {
          "type": "object",
          "description": "rheology column",
          "properties": {
            "cell_identity": {
              "type": "string"
            },
            "cell_ontology": {
              "$ref": "#/$defs/Identifier"
            },
            "cellosaurus": {
              "$ref": "#/$defs/Identifier"
            },
            "human_cell_atlas": {
              "$ref": "#/$defs/Identifier"
            },
            "cell_genome": {
              "$ref": "#/$defs/Identifier"
            },
            "perturbations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "cytoskeleton": {
          "type": "object",
          "description": "force-generation column",
          "properties": {
